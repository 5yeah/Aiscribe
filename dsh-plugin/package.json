{
  "name": "@local/aireport-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connects Aiscribe's local MCP server so the agent can read AI session history and generate daily/weekly reports.",
  "keywords": ["dsh", "dsh-plugin", "mcp", "aireport", "report"],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
